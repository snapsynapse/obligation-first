{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obligationfirst.org/v1/schema/proceeding.schema.json",
  "title": "Proceeding",
  "description": "A legal proceeding, enforcement action, or adjudicative matter. heardBy identifies the adjudicative or administrative body; issuedBy is retained only as a v0.5 compatibility spelling.",
  "type": "object",
  "required": ["@type", "@id", "title"],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "@id": { "type": "string", "format": "uri" },
    "@type": { "const": "of:Proceeding" },
    "title": { "type": "string", "minLength": 1 },
    "citation": { "type": "string" },
    "filed_date": { "type": "string", "format": "date" },
    "heardBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "issuedBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet", "description": "Legacy v0.5 spelling for a proceeding's hearing authority. Use heardBy." },
    "parties": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "actor_roles": {
      "type": "array",
      "items": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/actorRole" },
      "minItems": 1
    },
    "hasAllegation": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "hasDetermination": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "source": { "type": "string", "format": "uri" },
    "source_citation": { "type": "string" },
    "source_locator": { "type": "string" },
    "source_version": { "type": "string" },
    "language": { "type": "string" },
    "evidence_type": { "type": "string" },
    "verified": { "type": "string", "format": "date" },
    "retrieved": { "type": "string", "format": "date" },
    "asserted_by_adopter": { "type": "string", "format": "uri" },
    "ecli_uri": { "type": "string", "format": "uri" },
    "neutral_citation": { "type": "string" },
    "jurisdiction": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/jurisdiction" },
    "territorial_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "institutional_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "sameAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "exactMatch": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "describesSameEntityAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "notes": { "type": "string" }
  },
  "anyOf": [
    { "required": ["heardBy"] },
    { "required": ["issuedBy"] }
  ],
  "additionalProperties": true
}
