{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obligationfirst.org/v1/schema/instrument.schema.json",
  "title": "Instrument",
  "description": "A normative artifact such as legislation, regulation, agreement, judgment, guidance, or standard. Normative force is independent of lifecycle, operative effect, and enforcement state.",
  "type": "object",
  "required": ["@type", "@id", "title"],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "@id": { "type": "string", "format": "uri" },
    "@type": { "const": "of:Instrument" },
    "title": { "type": "string", "minLength": 1 },
    "short_title": { "type": "string" },
    "citation": { "type": "string" },
    "issuedBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "administeredBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "regulatedBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "enforcedBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "parties": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "actor_roles": {
      "type": "array",
      "items": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/actorRole" },
      "minItems": 1
    },
    "kind": { "type": "string", "minLength": 1 },
    "normative_force": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/normativeForce" },
    "binding_basis": {
      "anyOf": [
        { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/bindingBasis" },
        { "type": "array", "items": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/bindingBasis" }, "minItems": 1 }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "enacted", "in-force", "amended", "sunset", "repealed", "superseded", "withdrawn"],
      "description": "Legacy v0.5 lifecycle field. New records should use lifecycle_status."
    },
    "lifecycle_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/lifecycleStatus" },
    "operative_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/operativeStatus" },
    "enforcement_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/enforcementStatus" },
    "computed_as_of": { "type": "string", "format": "date" },
    "enacted": { "type": "string", "format": "date" },
    "effective": { "type": "string", "format": "date" },
    "full_enforcement": { "type": "string", "format": "date" },
    "sunset": { "type": "string", "format": "date" },
    "supersedes": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "wouldSupersede": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "repeals": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "amends": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "embodies_determination": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "hasTerm": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "source": { "type": "string", "format": "uri" },
    "source_citation": { "type": "string" },
    "source_locator": { "type": "string" },
    "source_version": { "type": "string" },
    "language": { "type": "string" },
    "evidence_type": { "type": "string" },
    "verified": { "type": "string", "format": "date" },
    "retrieved": { "type": "string", "format": "date" },
    "asserted_by_adopter": { "type": "string", "format": "uri" },
    "akn_uri": { "type": "string", "format": "uri" },
    "eli_uri": { "type": "string", "format": "uri" },
    "urn_lex": { "type": "string", "pattern": "^urn:lex:" },
    "jurisdiction": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/jurisdiction" },
    "territorial_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "institutional_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "sameAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "exactMatch": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "describesSameEntityAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
