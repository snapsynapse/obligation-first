{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obligationfirst.org/v1/schema/determination.schema.json",
  "title": "Determination",
  "description": "An authoritative act that resolves allegations, recognizes or imposes obligations, constrains prior normative effects, or promulgates an Instrument. A forward-looking normative text is represented as an Instrument joined explicitly through resulting_instrument.",
  "type": "object",
  "required": ["@type", "@id", "issuedBy", "decides", "disposition"],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "@id": { "type": "string", "format": "uri" },
    "@type": { "const": "of:Determination" },
    "issued_date": { "type": "string", "format": "date" },
    "issuedBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "decides": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "Allegations resolved by this Determination. Administrative issuance may use an empty array."
    },
    "disposition": { "type": "string", "enum": ["confirmed", "rejected", "partial", "dismissed", "settled", "vacated", "issued"] },
    "content": { "type": "string", "minLength": 1, "description": "Exact ruling or determination content when distributable." },
    "summary": { "type": "string", "minLength": 1, "description": "Editorial account of the ruling content." },
    "anchors": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "recognizes": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "imposes": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "constrains": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "vacates": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "remedy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/remedy" },
    "target_instrument": { "type": "string", "format": "uri", "description": "Legacy v0.5 administrative target. Use resulting_instrument for a promulgated forward-looking Instrument." },
    "resulting_instrument": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "notes": { "type": "string" },
    "source": { "type": "string", "format": "uri" },
    "source_citation": { "type": "string" },
    "source_locator": { "type": "string" },
    "source_version": { "type": "string" },
    "language": { "type": "string" },
    "evidence_type": { "type": "string" },
    "verified": { "type": "string", "format": "date" },
    "retrieved": { "type": "string", "format": "date" },
    "asserted_by_adopter": { "type": "string", "format": "uri" },
    "ecli_uri": { "type": "string", "format": "uri" },
    "neutral_citation": { "type": "string" },
    "urn_lex": { "type": "string", "pattern": "^urn:lex:" },
    "jurisdiction": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/jurisdiction" },
    "territorial_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "institutional_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "sameAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "exactMatch": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "describesSameEntityAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" }
  },
  "allOf": [
    {
      "if": { "required": ["disposition"], "properties": { "disposition": { "const": "issued" } } },
      "then": {
        "properties": { "decides": { "maxItems": 0 } },
        "anyOf": [
          { "required": ["target_instrument"] },
          { "required": ["resulting_instrument"] },
          { "required": ["anchors"] }
        ]
      }
    },
    {
      "if": { "required": ["disposition"], "properties": { "disposition": { "not": { "const": "issued" } } } },
      "then": { "properties": { "decides": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": true
}
