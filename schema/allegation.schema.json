{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obligationfirst.org/v1/schema/allegation.schema.json",
  "title": "Allegation",
  "description": "An asserted but not yet determined claim within a Proceeding. Assertions remain distinct from findings, and alleged violations point to concrete Obligations when the source supports that link.",
  "type": "object",
  "required": ["@type", "@id", "text"],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "@id": { "type": "string", "format": "uri" },
    "@type": { "const": "of:Allegation" },
    "text": { "type": "string", "minLength": 1 },
    "asserted_by": { "type": "string", "description": "Legacy v0.5 string fallback. Use asserted_by_party when the party is identified." },
    "asserted_by_party": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "allegedly_violates": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "related_to": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "related_to_party": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "jurisdiction": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/jurisdiction" },
    "territorial_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "institutional_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
    "source": { "type": "string", "format": "uri" },
    "source_citation": { "type": "string" },
    "source_locator": { "type": "string" },
    "source_version": { "type": "string" },
    "language": { "type": "string" },
    "evidence_type": { "type": "string" },
    "verified": { "type": "string", "format": "date" },
    "retrieved": { "type": "string", "format": "date" },
    "asserted_by_adopter": { "type": "string", "format": "uri" },
    "sameAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "exactMatch": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "describesSameEntityAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
