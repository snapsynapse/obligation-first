{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obligationfirst.org/v1/schema/term.schema.json",
  "title": "Term",
  "description": "A clause or provision within an Instrument. A Term is specification content; contractual Terms may additionally be treated as contract terms. text is reserved for exact source text and summary for editorial paraphrase.",
  "type": "object",
  "required": ["@type", "@id", "parent_instrument"],
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "@id": { "type": "string", "format": "uri" },
    "@type": {
      "anyOf": [
        { "const": "of:Term" },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "contains": { "const": "of:Term" },
          "minItems": 2,
          "uniqueItems": true
        }
      ],
      "description": "The Obligation-First record type. Contractual Terms may also assert gist:ContractTerm in this JSON-LD type set."
    },
    "text": { "type": "string", "minLength": 1, "description": "Exact source text. Editorial paraphrase must use summary." },
    "summary": { "type": "string", "minLength": 1, "description": "Editorial summary or normalized description, not represented as a quotation from the source." },
    "section": { "type": "string" },
    "parent_instrument": { "type": "string", "format": "uri" },
    "creates": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "defeats": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "rebuts": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "undercuts": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "anchors": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "amends": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet", "description": "A partial Term-level modification. Instrument-level amendment uses the same predicate between Instruments." },
    "binding_basis": {
      "anyOf": [
        { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/bindingBasis" },
        { "type": "array", "items": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/bindingBasis" }, "minItems": 1 }
      ]
    },
    "lifecycle_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/lifecycleStatus" },
    "operative_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/operativeStatus" },
    "enforcement_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/enforcementStatus" },
    "effective": { "type": "string", "format": "date" },
    "full_enforcement": { "type": "string", "format": "date" },
    "sunset": { "type": "string", "format": "date" },
    "computed_as_of": { "type": "string", "format": "date" },
    "source": { "type": "string", "format": "uri" },
    "source_citation": { "type": "string" },
    "source_locator": { "type": "string" },
    "source_version": { "type": "string" },
    "language": { "type": "string" },
    "evidence_type": { "type": "string" },
    "verified": { "type": "string", "format": "date" },
    "retrieved": { "type": "string", "format": "date" },
    "asserted_by_adopter": { "type": "string", "format": "uri" },
    "executableEncoding": {
      "anyOf": [
        { "$ref": "https://obligationfirst.org/v1/schema/executable-encoding.schema.json" },
        { "type": "array", "items": { "$ref": "https://obligationfirst.org/v1/schema/executable-encoding.schema.json" }, "minItems": 1 }
      ]
    },
    "akn_uri": { "type": "string", "format": "uri" },
    "sameAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "exactMatch": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "describesSameEntityAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
    "notes": { "type": "string" }
  },
  "anyOf": [
    { "required": ["text"] },
    { "required": ["summary"] }
  ],
  "additionalProperties": true
}
