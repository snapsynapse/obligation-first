{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obligationfirst.org/v1/schema/obligation.schema.json",
  "title": "Obligation",
  "description": "A source-grounded normative position. The LegalRuleML-aligned quartet remains available, while of:Obligation explicitly represents a concrete duty whose deontic operator has not yet been verified. v0.6 forbids silently converting unknown classification into of:Requirement.",
  "type": "object",
  "required": ["@type", "@id", "title"],
  "oneOf": [
    { "$ref": "#/$defs/UnclassifiedObligation" },
    { "$ref": "#/$defs/Requirement" },
    { "$ref": "#/$defs/Restriction" },
    { "$ref": "#/$defs/Permission" },
    { "$ref": "#/$defs/Reparation" }
  ],
  "$defs": {
    "BaseObligation": {
      "type": "object",
      "required": ["@type", "@id", "title"],
      "properties": {
        "@context": { "type": ["string", "array", "object"] },
        "@id": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "created_by": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "recognized_by": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "imposed_by": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "duty_holder_type": { "type": "string", "description": "Legacy v0.5 string fallback. New records should use duty_holders, actor_roles, and applicability." },
        "duty_holders": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "duty_holder_roles": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet", "description": "Controlled role IRIs for duty holders when the obligation applies to a role rather than a known concrete Party." },
        "owed_to": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "owed_to_roles": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet", "description": "Controlled beneficiary-role IRIs, kept separate from concrete Party identity." },
        "actor_roles": {
          "type": "array",
          "items": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/actorRole" },
          "minItems": 1
        },
        "applicability": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            { "type": "object", "minProperties": 1 },
            { "type": "array", "items": { "type": "object", "minProperties": 1 }, "minItems": 1 }
          ]
        },
        "trigger": { "type": "string", "description": "Legacy v0.5 trigger summary." },
        "grounds": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "triggers": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "isCategorizedBy": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "binding_basis": {
          "anyOf": [
            { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/bindingBasis" },
            { "type": "array", "items": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/bindingBasis" }, "minItems": 1 }
          ]
        },
        "anchors": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "violationOf": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "lifecycle_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/lifecycleStatus" },
        "operative_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/operativeStatus" },
        "enforcement_status": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/enforcementStatus" },
        "effective": { "type": "string", "format": "date" },
        "full_enforcement": { "type": "string", "format": "date" },
        "sunset": { "type": "string", "format": "date" },
        "computed_as_of": { "type": "string", "format": "date" },
        "jurisdiction": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/jurisdiction" },
        "territorial_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
        "institutional_scope": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/stringSet" },
        "source": { "type": "string", "format": "uri" },
        "source_citation": { "type": "string" },
        "source_locator": { "type": "string" },
        "source_version": { "type": "string" },
        "language": { "type": "string" },
        "evidence_type": { "type": "string" },
        "verified": { "type": "string", "format": "date" },
        "retrieved": { "type": "string", "format": "date" },
        "asserted_by_adopter": { "type": "string", "format": "uri" },
        "executableEncoding": {
          "anyOf": [
            { "$ref": "https://obligationfirst.org/v1/schema/executable-encoding.schema.json" },
            { "type": "array", "items": { "$ref": "https://obligationfirst.org/v1/schema/executable-encoding.schema.json" }, "minItems": 1 }
          ]
        },
        "sameAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "exactMatch": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet", "description": "Legacy concept crosswalk. Use isCategorizedBy for category membership." },
        "describesSameEntityAs": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["created_by"] },
        { "required": ["recognized_by"] },
        { "required": ["imposed_by"] }
      ],
      "additionalProperties": true
    },
    "UnclassifiedObligation": {
      "allOf": [
        { "$ref": "#/$defs/BaseObligation" },
        { "properties": { "@type": { "const": "of:Obligation" } } }
      ],
      "description": "A concrete source-grounded normative position whose deontic operator is not yet verified. This is an explicit evidence state, not a Requirement default."
    },
    "Requirement": {
      "allOf": [
        { "$ref": "#/$defs/BaseObligation" },
        { "properties": { "@type": { "const": "of:Requirement" } } }
      ]
    },
    "Restriction": {
      "allOf": [
        { "$ref": "#/$defs/BaseObligation" },
        { "properties": { "@type": { "const": "of:Restriction" } } }
      ]
    },
    "Permission": {
      "allOf": [
        { "$ref": "#/$defs/BaseObligation" },
        { "properties": { "@type": { "const": "of:Permission" } } }
      ]
    },
    "Reparation": {
      "allOf": [
        { "$ref": "#/$defs/BaseObligation" },
        {
          "required": ["triggers_on_violation_of"],
          "properties": {
            "@type": { "const": "of:Reparation" },
            "triggers_on_violation_of": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" },
            "remedy_kind": { "type": "string" },
            "enforcement_authority": { "$ref": "https://obligationfirst.org/v1/schema/common.schema.json#/$defs/iriSet" }
          }
        }
      ]
    }
  }
}
