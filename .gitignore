# docs/ is the GitHub Pages publish directory (main branch /docs), committed
# because Pages serves it. It is hand-authored, not generated: there is no
# `npm run build` script. Version strings across docs/ are synced by
# scripts/sync-version.mjs; release packages under docs/releases/ are generated
# by scripts/make-release.mjs. Everything else in docs/ is edited by hand.

